[Unit]
Description=UNO Q Wi-Fi reboot page (trusted development network)
Wants=sys-subsystem-net-devices-wlan0.device
After=network.target sys-subsystem-net-devices-wlan0.device

[Service]
User=arduino
ExecStart=/usr/bin/python3 -B /usr/local/lib/xgo-duck/wifi-reboot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
